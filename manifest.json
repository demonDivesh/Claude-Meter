{
  "manifest_version": 3,
  "name": "Claude Meter",
  "version": "1.0.1",
  "description": "Local-only token & context usage estimator for claude.ai. No servers, no tracking — everything stays on your device.",
  "homepage_url": "https://github.com/example/claude-meter",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Claude Meter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "dashboard/index.html",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  },
  "minimum_chrome_version": "114"
}
